# =============================================================================
# 5agents - 環境変数テンプレート
# このファイルをコピーして `.env` を作成してください: cp .env.example .env
# .env は絶対にGitにコミットしないこと (.gitignore で除外済み)
# =============================================================================

# --- LLM: Google Gemini (A Researcher / B Analyst / E Finalizer) ---
# Google AI Studio で取得: https://aistudio.google.com/app/apikey
# 無料枠: gemini-2.5-flash = 20 RPD, gemini-2.5-flash-lite = 1000 RPD
GOOGLE_API_KEY=your_gemini_api_key_here

# A Researcher / E Finalizer (Flash)
GEMINI_MODEL_MAIN=gemini-2.5-flash
# B Analyst (Flash-Lite, Flash 枠を温存しつつ Gemini 系統の連続性を確保)
GEMINI_MODEL_SUB=gemini-2.5-flash-lite

# --- LLM: Groq Llama (C Critic / D Fact-checker) ---
# 取得先: https://console.groq.com/keys (Google/GitHub ログインで無料、CC 不要)
# 無料枠: 14,400 RPD / 30 RPM ≒ 実質無制限
# Gemini Flash の 20 RPD 制限を回避しつつ、Meta 系統で C/D に独立な検証視点を持たせる
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Web 検索 (Tavily) ---
# 取得先: https://tavily.com/
# 無料枠: 1,000 リクエスト/月
TAVILY_API_KEY=your_tavily_api_key_here

# --- データ永続化先 ---
CHROMA_PERSIST_DIR=./data/chroma_db
SQLITE_PATH=./data/agents.sqlite3

# --- 通知 (Phase 4, 任意) ---
# ⚠️ LINE Notify は 2025/3 で終了。LINE で双方向にやり取りしたい場合は
# 下の「Phase 5: LINE Messaging API」を使う。
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# --- LINE Messaging API (Phase 5: LINE 連携, 任意) ---
# 取得: https://developers.line.biz/ で Messaging API channel を作成
# 詳細手順は docs/LINE_SETUP.md を参照
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
# 自分の LINE User ID (カンマ区切りで複数可)
# 取得方法: webhook 起動後に LINE で何か送信、logs/line-webhook.log で確認
LINE_ALLOWED_USER_IDS=Uxxxxxxxxxxxxxxx
# Webhook 用 FastAPI の listen ポート
WEBHOOK_PORT=8080
# LINE Flex Message の「詳細を見る」ボタンが開く Streamlit URL
STREAMLIT_BASE_URL=http://localhost:8501

# --- 定期実行 (Phase 4) ---
WATCHLIST_FILE=./watchlist.txt

# --- 動作モード ---
# development | production
APP_ENV=development
LOG_LEVEL=INFO

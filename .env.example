# =============================================================================
# 5agents - 環境変数テンプレート
# このファイルをコピーして `.env` を作成してください: cp .env.example .env
# .env は絶対にGitにコミットしないこと (.gitignore で除外済み)
# =============================================================================

# --- LLM (Gemini) ---
# Google AI Studio で取得: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# --- Web検索 (Tavily) ---
# 取得先: https://tavily.com/
# 無料枠: 1,000 リクエスト/月
TAVILY_API_KEY=your_tavily_api_key_here

# --- モデル設定 ---
# メインモデル (A/B/E エージェント用)
GEMINI_MODEL_MAIN=gemini-2.5-flash
# サブモデル (C/D エージェント用)
GEMINI_MODEL_SUB=gemini-2.5-flash-lite

# --- データ永続化先 ---
CHROMA_PERSIST_DIR=./data/chroma_db
SQLITE_PATH=./data/agents.sqlite3

# --- 動作モード ---
# development | production
APP_ENV=development
LOG_LEVEL=INFO
